generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             Int      @id @default(autoincrement())
  name           String
  description    String   @default("")
  repository_url String   @default("")
  created_at     DateTime
  updated_at     DateTime
  user_id        String
  tickets        Ticket[]

  @@index([user_id])
  @@map("projects")
}

model ProgressItem {
  id           Int       @id @default(autoincrement())
  ticket_id    Int
  content      String
  completed    Int       @default(0)
  position     Int       @default(0)
  created_at   DateTime
  completed_at DateTime?
  ticket       Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("progress_items")
}

model WorkLog {
  id           Int      @id @default(autoincrement())
  ticket_id    Int
  type         String   @default("code")
  description  String
  what_remains String   @default("")
  next_action  String   @default("")
  commit_hash  String   @default("")
  created_at   DateTime
  ticket       Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id, created_at])
  @@map("work_logs")
}

model TicketFile {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  file_path  String
  created_at DateTime
  ticket     Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("ticket_files")
}

model TicketNote {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  content    String
  created_at DateTime
  updated_at DateTime
  ticket     Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("ticket_notes")
}

model WorkSession {
  id           Int       @id @default(autoincrement())
  ticket_id    Int
  started_at   DateTime
  paused_at    DateTime?
  ended_at     DateTime?
  pause_reason String    @default("")
  summary      String    @default("")
  next_action  String    @default("")
  ticket       Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id, started_at])
  @@map("work_sessions")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Ticket {
  id                  Int            @id @default(autoincrement())
  project_id          Int
  ticket_key          String         @unique
  title               String
  description         String         @default("")
  status              String         @default("in_progress")
  priority            String         @default("medium")
  due_date            DateTime?
  my_context          String         @default("")
  why_implementing    String         @default("")
  how_it_works        String         @default("")
  important_decisions String         @default("")
  next_action         String         @default("")
  created_at          DateTime
  updated_at          DateTime
  completed_at        DateTime?
  progress_items      ProgressItem[]
  ticket_files        TicketFile[]
  ticket_notes        TicketNote[]
  project             Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_logs           WorkLog[]
  work_sessions       WorkSession[]
  summary             String?

  @@index([project_id])
  @@map("tickets")
}
